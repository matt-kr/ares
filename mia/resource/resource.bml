//Lumiverse: entries pointing at ../Firmware/stripped-placeholder.rom are
//deliberately NOT compiled into libmia. The symbols stay (1-byte arrays) so
//the mia/system loaders still build, but no vendor firmware bytes ship:
//  Game Boy / Game Boy Color boot ROMs are supplied at runtime by the app
//  (clean-room SameBoy images installed at <home>/<system>.sys/boot.rom and
//  swapped into the system pak in LumiverseAresN64Runtime.cpp).
//  Mega Drive / 32X / WonderSwan / Pocket Challenge / ZX Spectrum are not
//  shipped by Lumiverse.
//Nintendo 64 (PIF/CIC) and Super Famicom (IPL + coprocessor firmware) are
//kept: the N64 core loads pif.*.rom at power-on and the SMP boots from the
//IPL ROM; there is no clean-room replacement for either yet.
namespace name=Resource
  namespace name=GameBoy
    binary name=BootDMG0 file="../Firmware/stripped-placeholder.rom"
    binary name=BootDMG1 file="../Firmware/stripped-placeholder.rom"
    binary name=BootMGB file="../Firmware/stripped-placeholder.rom"
  namespace name=GameBoyColor
    binary name=BootCGB0 file="../Firmware/stripped-placeholder.rom"
    binary name=BootCGB1 file="../Firmware/stripped-placeholder.rom"
  namespace name=MegaDrive
    binary name=TMSS file="../Firmware/stripped-placeholder.rom"
    binary name=SVP file="../Firmware/stripped-placeholder.rom"
  namespace name=Mega32X
    binary name=Vector file="../Firmware/stripped-placeholder.rom"
    binary name=SH2BootM file="../Firmware/stripped-placeholder.rom"
    binary name=SH2BootS file="../Firmware/stripped-placeholder.rom"
  namespace name=Nintendo64
    binary name=CIC6101 file="../Firmware/Nintendo 64/cic.6101.rom"
    binary name=CIC6102 file="../Firmware/Nintendo 64/cic.6102.rom"
    binary name=CIC6105 file="../Firmware/Nintendo 64/cic.6105.rom"
    binary name=CIC7101 file="../Firmware/Nintendo 64/cic.7101.rom"
    binary name=PIFSM5 file="../Firmware/Nintendo 64/pif.sm5.rom"
    binary name=PIFNTSC file="../Firmware/Nintendo 64/pif.ntsc.rom"
    binary name=PIFPAL file="../Firmware/Nintendo 64/pif.pal.rom"
  namespace name=SuperFamicom
    binary name=IPLROM file="../Firmware/Super Famicom/ipl.rom"
    binary name=Cx4 file="../Firmware/Super Famicom/cx4.rom"
    binary name=DSP1 file="../Firmware/Super Famicom/dsp1.rom"
    binary name=DSP1B file="../Firmware/Super Famicom/dsp1b.rom"
    binary name=DSP2 file="../Firmware/Super Famicom/dsp2.rom"
    binary name=DSP3 file="../Firmware/Super Famicom/dsp3.rom"
    binary name=DSP4 file="../Firmware/Super Famicom/dsp4.rom"
    binary name=SGB1 file="../Firmware/Super Famicom/sgb1.rom"
    binary name=SGB2 file="../Firmware/Super Famicom/sgb2.rom"
    binary name=ST010 file="../Firmware/Super Famicom/st010.rom"
    binary name=ST011 file="../Firmware/Super Famicom/st011.rom"
    binary name=ST018 file="../Firmware/Super Famicom/st018.rom"
    binary name=S21FX file="../Firmware/Super Famicom/21fx.rom"
  namespace name=WonderSwan
    binary name=Boot file="../Firmware/stripped-placeholder.rom"
  namespace name=WonderSwanColor
    binary name=Boot file="../Firmware/stripped-placeholder.rom"
  namespace name=PocketChallengeV2
    binary name=Boot file="../Firmware/stripped-placeholder.rom"
  namespace name=ZXSpectrum
    binary name=BIOS file="../Firmware/stripped-placeholder.rom"
  namespace name=ZXSpectrum128
    binary name=BIOS file="../Firmware/stripped-placeholder.rom"
    binary name=Sub file="../Firmware/stripped-placeholder.rom"
